{
  "_seedAdminNote": "如需引导管理员，请用环境变量 AUTH_SEED_ADMIN_USERNAME / AUTH_SEED_ADMIN_PASSWORD 注入（切勿写进本文件或 appsettings.json）",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fileupload;Username=postgres;Password=<DB_PASSWORD>"
  },
  "Auth": {
    "FileServerAdminBaseUrl": "http://localhost:7000",
    "UserKeyExpireMinutes": 129600,
    "RenewThresholdMinutes": 43200,
    "RenewalScanMinutes": 360,
    "SessionTtlDays": 30,
    "RegistrationEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}

